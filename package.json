{
  "name": "ordinal-interface",
  "private": true,
  "version": "1.5.4",
  "description": "序数界面1 v1.5.4 的网页前端版 —— 大可数序数记号可视化浏览器（ONP2 协议）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify": "esbuild tests/verify.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify.mjs --log-level=warning && node node_modules/.cache/verify.mjs",
    "bench": "esbuild tests/bench.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/bench.mjs --log-level=warning && node node_modules/.cache/bench.mjs",
    "check-names": "esbuild tests/check_names.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/check_names.mjs --log-level=warning && node node_modules/.cache/check_names.mjs",
    "verify:notations": "esbuild tests/verify_notations.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify_notations.mjs --log-level=warning && node node_modules/.cache/verify_notations.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
